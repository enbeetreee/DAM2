<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ImageView
        android:id="@+id/char_img"
        android:scaleType="fitCenter"
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:contentDescription="Character Image"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@tools:sample/backgrounds/scenic"
        />

    <TextView
        android:id="@+id/char_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/layout_margin"
        android:layout_marginEnd="@dimen/layout_margin"
        android:ellipsize="end"
        android:gravity="center"
        android:lines="1"
        android:textSize="35sp"
        app:layout_constraintEnd_toEndOf="@id/char_img"
        app:layout_constraintStart_toStartOf="@id/char_img"
        app:layout_constraintTop_toBottomOf="@id/char_img"
        tools:text="Character" />

</androidx.constraintlayout.widget.ConstraintLayout>